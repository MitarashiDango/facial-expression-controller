.hidden {
    display: none;
}

.invisible {
    visibility: hidden;
}

.expression-editor-icon {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.expression-editor-icon__image {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
}

.expression-editor-icon__fallback-label {
    margin: 0;
    padding: 0;
    font-size: 10px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.expression-editor {
    padding: 8px;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.header-container {
    flex-shrink: 0;
    min-width: 0;
}

/* ドキュメントバー（1 行目）。クリップ欄を残りの幅に広げ、右に新規・保存 ▾・プレビューのボタンを並べる。 */
.document-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    min-width: 0;
}

.document-clip-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 4px;
}

.document-bar-button {
    flex-shrink: 0;
    min-width: 48px;
    margin: 1px 4px 1px 0;
}

/* 「保存」と ▾ を 1 つのボタンのようにつなげる。 */
.split-button {
    flex-direction: row;
    flex-shrink: 0;
    margin: 1px 4px 1px 0;
}

.split-button__main {
    min-width: 48px;
    margin: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.split-button__menu {
    min-width: 18px;
    margin: 0;
    padding: 0 2px;
    border-left-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    align-items: center;
    justify-content: center;
}

/* シーンへのプレビューの切り替え（目のアイコン）。オンのときは絞り込みのチップと同じ青で示す。 */
.preview-toggle-button {
    flex-shrink: 0;
    min-width: 24px;
    margin: 1px 0;
    padding: 0 4px;
    align-items: center;
    justify-content: center;
}

.preview-toggle-button.selected {
    border-color: rgb(77, 160, 255);
    background-color: rgba(77, 160, 255, 0.30);
}

.light-skin .preview-toggle-button.selected {
    border-color: rgb(0, 92, 200);
    background-color: rgba(0, 92, 200, 0.18);
}

/* 対象（アバター・Renderer）の折りたたみ。見出しの Hierarchy パスが長いときは省略する。 */
.target-foldout {
    margin-bottom: 4px;
    min-width: 0;
}

.target-foldout .unity-foldout__input {
    min-width: 0;
}

.target-foldout .unity-foldout__text {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.target-container {
    min-width: 0;
}

.target-field {
    min-width: 0;
}

/* 補足説明を tooltip で示す ⓘ アイコン。 */
.info-icon {
    margin-left: 4px;
    margin-right: 4px;
}

/*
 * フレームモードの行。「1 フレーム｜2 フレーム」のセグメント切替、2 フレームのときだけ出すフレームバー、ⓘ を 1 行に並べる。
 * 幅が足りないときはフレームバーを次の行へ折り返す。
 */
.frame-mode-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 4px;
    min-width: 0;
}

/* セグメント切替。ボタンをつなげて置き、選んでいる側はチップと同じ青で示す。 */
.segmented-control {
    flex-direction: row;
    flex-shrink: 0;
    margin: 1px 8px 1px 0;
}

.segmented-control__button {
    min-width: 64px;
    margin: 0;
    padding: 0 8px;
}

.segmented-control__button--first {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.segmented-control__button--last {
    border-left-width: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

.segmented-control__button.selected {
    border-color: rgb(77, 160, 255);
    background-color: rgba(77, 160, 255, 0.30);
    color: rgb(235, 244, 255);
}

.light-skin .segmented-control__button.selected {
    border-color: rgb(0, 92, 200);
    background-color: rgba(0, 92, 200, 0.18);
    color: rgb(0, 45, 110);
}

/* 2 フレームのフレームバー。始点の◆と ▾・ウェイトプレビューのつまみ・終点の◆を 1 本に並べ、行の残りの幅に広げる。 */
.frame-bar {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 260px;
    min-width: 220px;
}

/*
 * 始点・終点の◆。編集中の側は枠と背景を青にし、◆を塗りつぶす。
 * 編集していない側の◆は中抜きにし、一覧の行で「もう一方のフレームの値」を示す印と同じ色にする。
 */
.frame-marker {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin: 1px 0;
    padding: 0 6px 0 5px;
}

.frame-marker.split-button__main {
    margin: 0;
}

.frame-marker__diamond {
    width: 8px;
    height: 8px;
    margin: 0 5px 0 2px;
    border-width: 1.5px;
    border-color: rgb(255, 176, 64);
    background-color: rgba(0, 0, 0, 0);
    rotate: 45deg;
}

.light-skin .frame-marker__diamond {
    border-color: rgb(196, 110, 0);
}

.frame-marker__label {
    margin: 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.frame-marker.selected {
    border-color: rgb(77, 160, 255);
    background-color: rgba(77, 160, 255, 0.30);
}

.frame-marker.selected .frame-marker__diamond {
    border-color: rgb(77, 160, 255);
    background-color: rgb(77, 160, 255);
}

.frame-marker.selected .frame-marker__label {
    color: rgb(235, 244, 255);
}

.light-skin .frame-marker.selected {
    border-color: rgb(0, 92, 200);
    background-color: rgba(0, 92, 200, 0.18);
}

.light-skin .frame-marker.selected .frame-marker__diamond {
    border-color: rgb(0, 92, 200);
    background-color: rgb(0, 92, 200);
}

.light-skin .frame-marker.selected .frame-marker__label {
    color: rgb(0, 45, 110);
}

/* つまみの左右の間隔は、どちらも 6px にする（左は ▾ の右余白 4px と合わせて 6px）。 */
.frame-weight-slider {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 60px;
    margin: 0 6px 0 2px;
}

.output-settings-container {
    padding: 2px 2px 4px 2px;
    min-width: 0;
}

.output-settings-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
}

.output-mode-field,
.output-reference-field {
    min-width: 0;
    margin-right: 8px;
}

/* ⓘ アイコンを出力範囲のすぐ横に置くため、出力範囲の右余白を詰める。 */
.output-mode-field {
    width: 320px;
    margin-right: 4px;
}

.output-mode-info-icon {
    margin-left: 0;
    margin-right: 4px;
}

.output-reference-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 220px;
}

.output-summary {
    margin-top: 3px;
    color: rgb(190, 190, 190);
}

.preserved-summary {
    margin-top: 2px;
    color: rgb(160, 160, 160);
}

.output-settings-message {
    margin-top: 4px;
}

.thumbnail-container {
    padding: 2px 2px 4px 2px;
    min-width: 0;
}

.partial-import-container {
    padding: 2px 2px 4px 2px;
    min-width: 0;
}

.partial-import-view {
    min-width: 0;
}

.partial-import-source-row {
    min-width: 0;
}

.partial-import-field {
    min-width: 0;
}

.partial-import-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    min-width: 0;
}

.partial-import-search {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    margin-right: 4px;
}

.partial-import-button {
    flex-shrink: 0;
    min-width: 104px;
    margin-left: 4px;
}

.partial-import-summary {
    margin-top: 4px;
    color: rgb(170, 170, 170);
}

.partial-import-message {
    margin-top: 4px;
}

.partial-import-content-row {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
}

.partial-import-list-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.partial-import-list {
    height: 172px;
    min-height: 84px;
    margin-top: 4px;
    min-width: 0;
}

.partial-import-row {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding-left: 4px;
    padding-right: 4px;
    min-width: 0;
}

.partial-import-row.disabled {
    opacity: 0.72;
}

.partial-import-toggle {
    width: 24px;
    flex-shrink: 0;
}

.partial-import-name {
    min-width: 120px;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.partial-import-value {
    width: 58px;
    flex-shrink: 0;
    margin-left: 6px;
    -unity-text-align: middle-right;
}

.partial-import-reason {
    width: 96px;
    flex-shrink: 0;
    margin-left: 8px;
    color: rgb(190, 160, 80);
    -unity-text-align: middle-left;
}

.partial-import-preview {
    width: 132px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 8px;
    margin-top: 4px;
}

.partial-import-preview-title {
    height: 18px;
    color: rgb(170, 170, 170);
    -unity-text-align: middle-center;
}

.partial-import-preview-image {
    width: 132px;
    height: 132px;
    background-color: rgba(64, 64, 64, 0.25);
}

.thumbnail-view {
    min-width: 0;
}

.thumbnail-body {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
}

.thumbnail-controls {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.thumbnail-preview {
    width: 132px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 8px;
    margin-top: 4px;
}

.thumbnail-settings,
.thumbnail-assignment {
    margin-top: 4px;
    min-width: 0;
}

.thumbnail-field {
    min-width: 0;
}

.thumbnail-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    min-width: 0;
}

.thumbnail-group-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.thumbnail-group-row > .thumbnail-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.thumbnail-reload-button {
    min-width: 82px;
    margin-left: 4px;
}

.thumbnail-button {
    align-self: flex-start;
    min-width: 112px;
    margin-top: 4px;
    margin-right: 4px;
}

.thumbnail-preview-image {
    width: 132px;
    height: 132px;
    background-color: rgba(64, 64, 64, 0.25);
}

.thumbnail-busy {
    width: 132px;
    margin-top: 4px;
}

.thumbnail-preview-button {
    width: 132px;
    min-width: 132px;
    max-width: 132px;
    margin-left: 0;
    margin-right: 0;
}

.thumbnail-path {
    margin-left: 184px;
    margin-bottom: 3px;
    color: rgb(170, 170, 170);
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 絞り込み行。検索・表示フィルターのチップ・位置フィルタを 1 行に並べ、幅が足りないときは折り返す。表示数は右端に置く。 */
.filter-container {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 0;
    margin-bottom: 4px;
    min-width: 0;
}

.filter-items {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* ToolbarSearchField には Toolbar 用のスタイルシートが直接付くため、クラス 2 つで指定する。 */
.filter-items .search-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 160px;
    min-width: 120px;
    margin: 1px 6px 1px 0;
}

/* 表示フィルターのチップ。オンのときは枠と背景を青にする。色はスキンごとに背景との差が出るものにする。 */
.filter-chip {
    flex-shrink: 0;
    height: 20px;
    margin: 1px 4px 1px 0;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgb(110, 110, 110);
    background-color: rgba(255, 255, 255, 0.04);
    -unity-text-align: middle-center;
}

.filter-toggle-chip:hover {
    background-color: rgba(128, 128, 128, 0.24);
}

.filter-chip.selected {
    border-color: rgb(77, 160, 255);
    background-color: rgba(77, 160, 255, 0.30);
    color: rgb(235, 244, 255);
}

.filter-toggle-chip.selected:hover {
    background-color: rgba(77, 160, 255, 0.42);
}

.light-skin .filter-chip {
    border-color: rgb(150, 150, 150);
    background-color: rgba(255, 255, 255, 0.35);
}

.light-skin .filter-toggle-chip:hover {
    background-color: rgba(128, 128, 128, 0.24);
}

.light-skin .filter-chip.selected {
    border-color: rgb(0, 92, 200);
    background-color: rgba(0, 92, 200, 0.18);
    color: rgb(0, 45, 110);
}

.light-skin .filter-toggle-chip.selected:hover {
    background-color: rgba(0, 92, 200, 0.28);
}

/* シーンから絞り込むモードの切り替えボタン（アイコンのみ）。オンのときはチップと同じ青で示す。 */
.filter-icon-button {
    flex-shrink: 0;
    min-width: 24px;
    height: 20px;
    margin: 1px 4px 1px 0;
    padding: 0 4px;
    align-items: center;
    justify-content: center;
}

.filter-icon-button.selected {
    border-color: rgb(77, 160, 255);
    background-color: rgba(77, 160, 255, 0.30);
}

.light-skin .filter-icon-button.selected {
    border-color: rgb(0, 92, 200);
    background-color: rgba(0, 92, 200, 0.18);
}

/* 位置フィルタの適用中に出すチップ。× ボタンで解除する。 */
.filter-location-chip {
    flex-direction: row;
    align-items: center;
    padding-right: 2px;
}

.filter-location-chip__label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.filter-chip-clear-button {
    flex-shrink: 0;
    min-width: 16px;
    height: 16px;
    margin: 0 0 0 3px;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.filter-chip-clear-button:hover {
    background-color: rgba(128, 128, 128, 0.35);
}

.filter-chip-clear-button .expression-editor-icon__image {
    width: 10px;
    height: 10px;
}

/* 右端の「表示数 / 全数」。高さは 1 行目のチップと揃える。 */
.filter-count {
    flex-shrink: 0;
    height: 22px;
    margin-left: 6px;
    -unity-text-align: middle-right;
    white-space: nowrap;
    color: rgb(170, 170, 170);
}

.light-skin .filter-count {
    color: rgb(90, 90, 90);
}

/*
 * 一覧（上側）と下部タブの中身（下側）の分割ビュー。下部タブがすべて閉じているときは下側を畳む。
 * 分割ビューは、上下それぞれの min-height を境界のドラッグとウィンドウの縮小の下限に使う。
 */
.body-split-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

/* 下部タブを開いても、一覧ヘッダーと 2 行分は残す。 */
.list-pane {
    flex-grow: 1;
    min-height: 96px;
    min-width: 0;
}

.list-panel {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.list-container {
    flex-grow: 1;
    min-height: 0;
    min-width: 0;
}

.blendshape-list {
    flex-grow: 1;
    min-height: 68px;
    min-width: 0;
}

/* 開いた下部タブの中身。中身が高さに収まらないときはタブごとにスクロールする。 */
.bottom-tab-panel {
    min-height: 80px;
    min-width: 0;
    padding-top: 4px;
}

.bottom-tab-page {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

/* 下部タブの見出し。常にウィンドウの一番下に置き、開いたタブは上側の中身とつながるよう上端を青で示す。 */
.bottom-tab-bar {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    min-width: 0;
    margin-top: 2px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.45);
}

.bottom-tab {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 22px;
    margin: 0 2px 0 0;
    padding: 0 8px;
    border-width: 0;
    border-top-width: 2px;
    border-top-color: rgba(0, 0, 0, 0);
    border-radius: 0 0 3px 3px;
    background-color: rgba(0, 0, 0, 0);
}

.bottom-tab:hover {
    background-color: rgba(128, 128, 128, 0.24);
}

.bottom-tab.selected {
    border-top-color: rgb(77, 160, 255);
    background-color: rgba(77, 160, 255, 0.22);
}

.light-skin .bottom-tab.selected {
    border-top-color: rgb(0, 92, 200);
    background-color: rgba(0, 92, 200, 0.14);
}

.bottom-tab__label {
    margin: 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.bottom-tab__warning-icon {
    margin-right: 3px;
}

/* 一覧ヘッダー。左余白は ListView の枠線 1px、行の左余白 4px、変更行の色帯 3px の合計に合わせる。 */
.blendshape-list-header {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 20px;
    padding-left: 8px;
    padding-right: 4px;
    min-width: 0;
}

.blendshape-header-target {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    border-radius: 2px;
}

.blendshape-header-target:hover {
    background-color: rgba(128, 128, 128, 0.24);
}

/* ▾ アイコンの幅と右余白は、行の鍵アイコンの列と同じにする。 */
.blendshape-header-menu-icon {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

.blendshape-header-menu-icon.expression-editor-icon--fallback {
    width: auto;
}

/* 名前の列幅（.blendshape-name-cell）から鍵アイコンの列（14px + 3px）を引いた幅。 */
.blendshape-header-name {
    width: 203px;
    min-width: 103px;
    max-width: 203px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.blendshape-header-value {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 6px;
    -unity-text-align: middle-left;
}

.blendshape-list-header.narrow .blendshape-header-name {
    width: 143px;
    min-width: 63px;
    max-width: 143px;
}

.blendshape-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: 4px;
    padding-right: 4px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    min-width: 0;
}

/* 変更済みの行は左端 3px の色帯と太字の名前で示す。色はスキンごとに背景との差が出る青にする。 */
.blendshape-row.changed {
    border-left-color: rgb(77, 160, 255);
}

.light-skin .blendshape-row.changed {
    border-left-color: rgb(0, 92, 200);
}

.blendshape-row.changed .blendshape-name {
    -unity-font-style: bold;
}

.blendshape-row.system-excluded {
    opacity: 0.72;
}

.blendshape-row.system-unlocked {
    opacity: 1;
}

.blendshape-row.user-excluded {
    opacity: 0.72;
}

.blendshape-target-toggle {
    flex-shrink: 0;
    margin: 0 4px 0 0;
}

/* 鍵アイコンと名前をまとめた名前の列。スライダーの位置を揃えるため幅を固定する。 */
.blendshape-name-cell {
    flex-direction: row;
    align-items: center;
    width: 220px;
    min-width: 120px;
    max-width: 220px;
    flex-grow: 0;
    flex-shrink: 1;
    overflow: hidden;
}

.blendshape-lock-icon {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

.blendshape-lock-icon.expression-editor-icon--fallback {
    width: auto;
}

/* 名前は列の残り幅いっぱいに広げ（tooltip を列全体で出す）、幅が足りないときは省略する。 */
.blendshape-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.blendshape-slider {
    min-width: 120px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 6px;
    margin-right: 6px;
}

/* 初期値の目盛り。位置は BlendShapeListView がつまみの中心に合わせて設定する。 */
.blendshape-initial-tick {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 10px;
    background-color: rgba(230, 230, 230, 0.85);
}

.light-skin .blendshape-initial-tick {
    background-color: rgba(32, 32, 32, 0.85);
}

/*
 * 2 フレームのとき、もう一方のフレームの値を示す中抜きのひし形。初期値の目盛り（縦線）とつまみとは形と色で見分ける。
 * 色はフレームバーで編集していない側の◆と同じにする。位置は BlendShapeListView がつまみの中心に合わせて設定する。
 */
.blendshape-other-frame-marker {
    position: absolute;
    left: 0;
    top: 0;
    width: 7px;
    height: 7px;
    border-width: 1.5px;
    border-color: rgb(255, 176, 64);
    background-color: rgba(0, 0, 0, 0);
    rotate: 45deg;
}

.light-skin .blendshape-other-frame-marker {
    border-color: rgb(196, 110, 0);
}

.blendshape-value {
    width: 58px;
}

.blendshape-reset-button {
    flex-shrink: 0;
    min-width: 22px;
    height: 20px;
    margin-left: 4px;
    margin-right: 0;
    padding: 0 3px;
    align-items: center;
    justify-content: center;
}

.blendshape-output-status {
    width: 72px;
    flex-shrink: 0;
    margin-left: 6px;
    color: rgb(170, 190, 210);
    -unity-text-align: middle-left;
}

.blendshape-list.narrow .blendshape-name-cell {
    width: 160px;
    min-width: 80px;
    max-width: 160px;
}

.blendshape-list.narrow .blendshape-slider {
    min-width: 80px;
}

.blendshape-list.narrow .blendshape-output-status {
    display: none;
}

/* 0 件表示。絞り込みが原因のときは「絞り込みを解除」ボタンを文言の横に出す。 */
.empty-state {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
}

.empty-label {
    margin-top: 8px;
    margin-bottom: 8px;
    color: rgb(180, 180, 180);
}

.clear-filters-button {
    flex-shrink: 0;
    margin-left: 8px;
}
