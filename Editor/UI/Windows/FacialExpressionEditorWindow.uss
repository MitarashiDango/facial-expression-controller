.hidden {
    display: none;
}

.invisible {
    visibility: hidden;
}

.expression-editor-icon {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.expression-editor-icon__image {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
}

.expression-editor-icon__fallback-label {
    margin: 0;
    padding: 0;
    font-size: 10px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.expression-editor {
    padding: 8px;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.header-container {
    flex-shrink: 0;
    min-width: 0;
}

.target-container {
    margin-bottom: 6px;
    min-width: 0;
}

.target-field {
    min-width: 0;
}

.toolbar-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
    min-width: 0;
}

.toolbar-container > Button {
    margin-right: 4px;
    min-width: 64px;
}

/* 補足説明を tooltip で示す ⓘ アイコン。 */
.info-icon {
    margin-left: 4px;
    margin-right: 4px;
}

.frame-mode-container {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    min-width: 0;
}

.frame-mode-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.weight-mode-container {
    margin-bottom: 6px;
    min-width: 0;
}

.frame-tab-container {
    flex-direction: row;
    margin-bottom: 4px;
    min-width: 0;
}

.frame-tab-button {
    min-width: 72px;
    margin-right: 4px;
}

.frame-tab-button.selected {
    background-color: rgba(64, 128, 192, 0.32);
}

.weight-preview-container {
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
}

.weight-preview-slider {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 0;
}

.load-start-button {
    align-self: flex-start;
    flex-shrink: 0;
    min-width: 0;
    max-width: 100%;
    margin-top: 4px;
    white-space: normal;
}

.output-settings-container {
    margin-bottom: 6px;
    min-width: 0;
}

.output-settings-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
}

.output-mode-field,
.output-reference-field {
    min-width: 0;
    margin-right: 8px;
}

/* ⓘ アイコンを出力範囲のすぐ横に置くため、出力範囲の右余白を詰める。 */
.output-mode-field {
    width: 320px;
    margin-right: 4px;
}

.output-mode-info-icon {
    margin-left: 0;
    margin-right: 4px;
}

.output-reference-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 220px;
}

.output-summary {
    margin-top: 3px;
    color: rgb(190, 190, 190);
}

.preserved-summary {
    margin-top: 2px;
    color: rgb(160, 160, 160);
}

.output-settings-message {
    margin-top: 4px;
}

.thumbnail-container {
    margin-bottom: 6px;
    min-width: 0;
}

.partial-import-container {
    margin-bottom: 6px;
    min-width: 0;
}

.partial-import-foldout {
    min-width: 0;
}

.partial-import-source-row {
    min-width: 0;
}

.partial-import-field {
    min-width: 0;
}

.partial-import-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
    min-width: 0;
}

.partial-import-search {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    margin-right: 4px;
}

.partial-import-button {
    flex-shrink: 0;
    min-width: 104px;
    margin-left: 4px;
}

.partial-import-summary {
    margin-top: 4px;
    color: rgb(170, 170, 170);
}

.partial-import-message {
    margin-top: 4px;
}

.partial-import-content-row {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
}

.partial-import-list-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.partial-import-list {
    height: 172px;
    min-height: 84px;
    margin-top: 4px;
    min-width: 0;
}

.partial-import-row {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding-left: 4px;
    padding-right: 4px;
    min-width: 0;
}

.partial-import-row.disabled {
    opacity: 0.72;
}

.partial-import-toggle {
    width: 24px;
    flex-shrink: 0;
}

.partial-import-name {
    min-width: 120px;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.partial-import-value {
    width: 58px;
    flex-shrink: 0;
    margin-left: 6px;
    -unity-text-align: middle-right;
}

.partial-import-reason {
    width: 96px;
    flex-shrink: 0;
    margin-left: 8px;
    color: rgb(190, 160, 80);
    -unity-text-align: middle-left;
}

.partial-import-preview {
    width: 132px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 8px;
    margin-top: 4px;
}

.partial-import-preview-title {
    height: 18px;
    color: rgb(170, 170, 170);
    -unity-text-align: middle-center;
}

.partial-import-preview-image {
    width: 132px;
    height: 132px;
    background-color: rgba(64, 64, 64, 0.25);
}

.thumbnail-foldout {
    min-width: 0;
}

.thumbnail-body {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
}

.thumbnail-controls {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.thumbnail-preview {
    width: 132px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 8px;
    margin-top: 4px;
}

.thumbnail-settings,
.thumbnail-assignment {
    margin-top: 4px;
    min-width: 0;
}

.thumbnail-field {
    min-width: 0;
}

.thumbnail-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    min-width: 0;
}

.thumbnail-group-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.thumbnail-group-row > .thumbnail-field {
    flex-grow: 1;
    flex-shrink: 1;
}

.thumbnail-reload-button {
    min-width: 82px;
    margin-left: 4px;
}

.thumbnail-button {
    align-self: flex-start;
    min-width: 112px;
    margin-top: 4px;
    margin-right: 4px;
}

.thumbnail-preview-image {
    width: 132px;
    height: 132px;
    background-color: rgba(64, 64, 64, 0.25);
}

.thumbnail-busy {
    width: 132px;
    margin-top: 4px;
}

.thumbnail-preview-button {
    width: 132px;
    min-width: 132px;
    max-width: 132px;
    margin-left: 0;
    margin-right: 0;
}

.thumbnail-path {
    margin-left: 184px;
    margin-bottom: 3px;
    color: rgb(170, 170, 170);
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 絞り込み行。検索・表示フィルターのチップ・位置フィルタを 1 行に並べ、幅が足りないときは折り返す。表示数は右端に置く。 */
.filter-container {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 6px;
    margin-bottom: 6px;
    min-width: 0;
}

.filter-items {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* ToolbarSearchField には Toolbar 用のスタイルシートが直接付くため、クラス 2 つで指定する。 */
.filter-items .search-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 160px;
    min-width: 120px;
    margin: 1px 6px 1px 0;
}

/* 表示フィルターのチップ。オンのときは枠と背景を青にする。色はスキンごとに背景との差が出るものにする。 */
.filter-chip {
    flex-shrink: 0;
    height: 20px;
    margin: 1px 4px 1px 0;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgb(110, 110, 110);
    background-color: rgba(255, 255, 255, 0.04);
    -unity-text-align: middle-center;
}

.filter-toggle-chip:hover {
    background-color: rgba(128, 128, 128, 0.24);
}

.filter-chip.selected {
    border-color: rgb(77, 160, 255);
    background-color: rgba(77, 160, 255, 0.30);
    color: rgb(235, 244, 255);
}

.filter-toggle-chip.selected:hover {
    background-color: rgba(77, 160, 255, 0.42);
}

.light-skin .filter-chip {
    border-color: rgb(150, 150, 150);
    background-color: rgba(255, 255, 255, 0.35);
}

.light-skin .filter-toggle-chip:hover {
    background-color: rgba(128, 128, 128, 0.24);
}

.light-skin .filter-chip.selected {
    border-color: rgb(0, 92, 200);
    background-color: rgba(0, 92, 200, 0.18);
    color: rgb(0, 45, 110);
}

.light-skin .filter-toggle-chip.selected:hover {
    background-color: rgba(0, 92, 200, 0.28);
}

/* シーンから絞り込むモードの切り替えボタン（アイコンのみ）。オンのときはチップと同じ青で示す。 */
.filter-icon-button {
    flex-shrink: 0;
    min-width: 24px;
    height: 20px;
    margin: 1px 4px 1px 0;
    padding: 0 4px;
    align-items: center;
    justify-content: center;
}

.filter-icon-button.selected {
    border-color: rgb(77, 160, 255);
    background-color: rgba(77, 160, 255, 0.30);
}

.light-skin .filter-icon-button.selected {
    border-color: rgb(0, 92, 200);
    background-color: rgba(0, 92, 200, 0.18);
}

/* 位置フィルタの適用中に出すチップ。× ボタンで解除する。 */
.filter-location-chip {
    flex-direction: row;
    align-items: center;
    padding-right: 2px;
}

.filter-location-chip__label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.filter-chip-clear-button {
    flex-shrink: 0;
    min-width: 16px;
    height: 16px;
    margin: 0 0 0 3px;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.filter-chip-clear-button:hover {
    background-color: rgba(128, 128, 128, 0.35);
}

.filter-chip-clear-button .expression-editor-icon__image {
    width: 10px;
    height: 10px;
}

/* 右端の「表示数 / 全数」。高さは 1 行目のチップと揃える。 */
.filter-count {
    flex-shrink: 0;
    height: 22px;
    margin-left: 6px;
    -unity-text-align: middle-right;
    white-space: nowrap;
    color: rgb(170, 170, 170);
}

.light-skin .filter-count {
    color: rgb(90, 90, 90);
}

.list-panel {
    flex-grow: 1;
    min-height: 120px;
    min-width: 0;
}

.list-container {
    flex-grow: 1;
    min-height: 120px;
    min-width: 0;
}

.blendshape-list {
    flex-grow: 1;
    min-height: 120px;
    min-width: 0;
}

/* 一覧ヘッダー。左余白は ListView の枠線 1px、行の左余白 4px、変更行の色帯 3px の合計に合わせる。 */
.blendshape-list-header {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 20px;
    padding-left: 8px;
    padding-right: 4px;
    min-width: 0;
}

.blendshape-header-target {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    border-radius: 2px;
}

.blendshape-header-target:hover {
    background-color: rgba(128, 128, 128, 0.24);
}

/* ▾ アイコンの幅と右余白は、行の鍵アイコンの列と同じにする。 */
.blendshape-header-menu-icon {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

.blendshape-header-menu-icon.expression-editor-icon--fallback {
    width: auto;
}

/* 名前の列幅（.blendshape-name-cell）から鍵アイコンの列（14px + 3px）を引いた幅。 */
.blendshape-header-name {
    width: 203px;
    min-width: 103px;
    max-width: 203px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.blendshape-header-value {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 6px;
    -unity-text-align: middle-left;
}

.blendshape-list-header.narrow .blendshape-header-name {
    width: 143px;
    min-width: 63px;
    max-width: 143px;
}

.blendshape-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: 4px;
    padding-right: 4px;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    min-width: 0;
}

/* 変更済みの行は左端 3px の色帯と太字の名前で示す。色はスキンごとに背景との差が出る青にする。 */
.blendshape-row.changed {
    border-left-color: rgb(77, 160, 255);
}

.light-skin .blendshape-row.changed {
    border-left-color: rgb(0, 92, 200);
}

.blendshape-row.changed .blendshape-name {
    -unity-font-style: bold;
}

.blendshape-row.system-excluded {
    opacity: 0.72;
}

.blendshape-row.system-unlocked {
    opacity: 1;
}

.blendshape-row.user-excluded {
    opacity: 0.72;
}

.blendshape-target-toggle {
    flex-shrink: 0;
    margin: 0 4px 0 0;
}

/* 鍵アイコンと名前をまとめた名前の列。スライダーの位置を揃えるため幅を固定する。 */
.blendshape-name-cell {
    flex-direction: row;
    align-items: center;
    width: 220px;
    min-width: 120px;
    max-width: 220px;
    flex-grow: 0;
    flex-shrink: 1;
    overflow: hidden;
}

.blendshape-lock-icon {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

.blendshape-lock-icon.expression-editor-icon--fallback {
    width: auto;
}

/* 名前は列の残り幅いっぱいに広げ（tooltip を列全体で出す）、幅が足りないときは省略する。 */
.blendshape-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.blendshape-slider {
    min-width: 120px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 6px;
    margin-right: 6px;
}

/* 初期値の目盛り。位置は BlendShapeListView がつまみの中心に合わせて設定する。 */
.blendshape-initial-tick {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 10px;
    background-color: rgba(230, 230, 230, 0.85);
}

.light-skin .blendshape-initial-tick {
    background-color: rgba(32, 32, 32, 0.85);
}

.blendshape-value {
    width: 58px;
}

.blendshape-reset-button {
    flex-shrink: 0;
    min-width: 22px;
    height: 20px;
    margin-left: 4px;
    margin-right: 0;
    padding: 0 3px;
    align-items: center;
    justify-content: center;
}

.blendshape-output-status {
    width: 72px;
    flex-shrink: 0;
    margin-left: 6px;
    color: rgb(170, 190, 210);
    -unity-text-align: middle-left;
}

.blendshape-list.narrow .blendshape-name-cell {
    width: 160px;
    min-width: 80px;
    max-width: 160px;
}

.blendshape-list.narrow .blendshape-slider {
    min-width: 80px;
}

.blendshape-list.narrow .blendshape-output-status {
    display: none;
}

/* 0 件表示。絞り込みが原因のときは「絞り込みを解除」ボタンを文言の横に出す。 */
.empty-state {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
}

.empty-label {
    margin-top: 8px;
    margin-bottom: 8px;
    color: rgb(180, 180, 180);
}

.clear-filters-button {
    flex-shrink: 0;
    margin-left: 8px;
}
